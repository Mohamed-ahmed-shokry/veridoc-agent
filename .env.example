# Phase 1 OCR configuration is optional; the application does not load this file.
# Set these variables in the process environment before starting Uvicorn.
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# TESSERACT_LANG=eng
# TESSERACT_TIMEOUT_SECONDS=30

# Phase 2 structured extraction configuration. Use a current vision-capable
# Responses API model; keep the API key in the process environment only.
# OPENAI_API_KEY=
# VERIDOC_LLM_MODEL=

# Phase 3 and Phase 8 local reference-data storage. Relative paths resolve from
# the process working directory.
# VERIDOC_REFERENCE_DATABASE=veridoc-reference.sqlite3

# Phase 8 local administration token. Use 32-256 allowed characters and keep the
# real value only in the process environment; the application does not load this
# example file.
# VERIDOC_ADMIN_TOKEN=

# Phase 9 local review workflow. Keep the review database separate from reference
# data, keep the actor file outside the repository, and use the exact HTTPS origin
# through which the browser reaches the review console.
# VERIDOC_REVIEW_DATABASE=veridoc-review.sqlite3
# VERIDOC_REVIEW_ACTORS_FILE=C:\\secure-config\\veridoc-review-actors.json
# VERIDOC_REVIEW_ORIGIN=https://review.example
